lt.length > 0 && context.workflow['action_10'].result[0].role_id;","__wwtype":"js"},"branches":[{"id":"action_12","value":true},{"id":null,"value":false}],"description":"Check if user query returned results with role_id","__wwdescription":"Check if user query returned results with role_id"},"action_12":{"id":"action_12","args":{"table":"roles","filters":[{"fn":"eq","value":{"code":"context.workflow['action_10'].result[0].role_id","__wwtype":"f"},"column":"id","isEnabled":true}],"dataFields":["id","name"],"fieldsMode":"guided"},"name":"Query role details","next":"action_13","type":"f9ef41c3-1c53-4857-855b-f2f6a40b7186-select","description":"Query roles table to check if role is admin","__wwdescription":"Query roles table to check if role is admin"},"action_13":{"id":"action_13","name":"Check if role is admin","next":null,"type":"if","value":{"code":"return context.workflow['action_12'].result && context.workflow['action_12'].result.length > 0 && context.workflow['action_12'].result[0].name === 'admin';","__wwtype":"js"},"branches":[{"id":"action_14","value":true},{"id":null,"value":false}],"description":"Check if the role name is 'admin'","__wwdescription":"Check if the role name is 'admin'"},"action_14":{"id":"action_14","name":"Set admin flag","next":"action_15","type":"variable","varId":"6a3c25f9-5eda-4390-a410-a8f0c767b7d7","varValue":true,"description":"Set isAdmin variable to true","__wwdescription":"Set isAdmin variable to true"},"action_15":{"id":"action_15","name":"Log admin status","next":null,"type":"log","level":"info","message":"User has admin role","__wwdescription":""}},"trigger":"onload","description":"Check if the current user has admin role by querying the Supabase database and set the isAdmin variable accordingly. Fetch pins data from Supabase.","firstAction":"action_1","firstErrorAction":"error_1"},{"id":"c37f69d1-087f-4b25-b8d2-e266d764c90c","name":"Fetch Map Pins","actions":{"6963fa4a-bc7e-457e-b7f0-b89c3a27c283":{"id":"6963fa4a-bc7e-457e-b7f0-b89c3a27c283","code":"// Initialize variables\nvariables['ab814f74-75bb-4643-a513-9816d65fc3bc'] = [];\nvariables['6a3c25f9-5eda-4390-a410-a8f0c767b7d7'] = false;\n\ntry {\n  // Check if user is authenticated\n  const isAuthenticated = pluginVariables['1fa0dd68-5069-436c-9a7d-3b54c340f1fa']['isAuthenticated'];\n  const user = pluginVariables['1fa0dd68-5069-436c-9a7d-3b54c340f1fa']['user'];\n  \n  // Fetch pins data from Supabase\n  const pinsCollection = await utilsFunctions.fetchCollection('f9ef41c3-1c53-4857-855b-f2f6a40b7186');\n  if (pinsCollection && pinsCollection.data) {\n    variables['ab814f74-75bb-4643-a513-9816d65fc3bc'] = pinsCollection.data;\n    console.log('Pins loaded:', pinsCollection.data.length, 'pins');\n  }\n  \n  // Check admin role if user is authenticated\n  if (isAuthenticated && user && user.id) {\n    try {\n      // Get user profile to check role_id\n      const userProfileCollection = await utilsFunctions.fetchCollection('user-profiles');\n      if (userProfileCollection && userProfileCollection.data) {\n        const userProfile = userProfileCollection.data.find(profile => profile.user_id === user.id);\n        \n        if (userProfile && userProfile.role_id) {\n          // Fetch roles to check if user has admin role\n          const rolesCollection = await utilsFunctions.fetchCollection('roles');\n          if (rolesCollection && rolesCollection.data) {\n            const adminRole = rolesCollection.data.find(role => \n              role.id === userProfile.role_id && role.name === 'admin'\n            );\n            \n            if (adminRole) {\n              variables['6a3c25f9-5eda-4390-a410-a8f0c767b7d7'] = true;\n              console.log('User has admin role');\n            }\n          }\n        }\n      }\n    } catch (roleError) {\n      console.log('Could not check admin role:', roleError.message);\n    }\n  }\n  \n} catch (error) {\n  console.error('Error loading map data:', error);\n}","next":null,"type":"custom-js"}},"